setStoreId":"","bold":true,"italic":false,"name":"HelpText","smoothed":true,"type":"TextObject::Text","underlined":false,"variables":[],"effects":[],"behaviors":[],"string":"Panah/A-D: jalan  |  SPACE: lompat  |  R: ulang","font":"","textAlignment":"left","characterSize":16.0,"color":{"b":255,"g":255,"r":255},"content":{"bold":true,"isOutlineEnabled":false,"isShadowEnabled":false,"italic":false,"outlineColor":"255;255;255","outlineThickness":2.0,"shadowAngle":90.0,"shadowBlurRadius":2.0,"shadowColor":"0;0;0","shadowDistance":4.0,"shadowOpacity":127.0,"smoothed":true,"underlined":false,"text":"Panah/A-D: jalan  |  SPACE: lompat  |  R: ulang","font":"","textAlignment":"left","verticalTextAlignment":"top","characterSize":16.0,"lineHeight":0.0,"color":"255;255;255"}}],"objectsFolderStructure":{"folderName":"__ROOT","children":[{"objectName":"Player"},{"objectName":"Background"},{"objectName":"Ground"},{"objectName":"Star1"},{"objectName":"Star2"},{"objectName":"Star3"},{"objectName":"Door"},{"objectName":"Hazard"},{"objectName":"Title"},{"objectName":"Identity"},{"objectName":"ScoreText"},{"objectName":"InfoText"},{"objectName":"VictoryText"},{"objectName":"HelpText"}]},"events":[{"type":"BuiltinCommonInstructions::JsCode","inlineCode":["(function(){","// Pixel Team Adventure - logic runs once per frame.","const get = (name) => runtimeScene.getObjects(name)[0];","const player = get('Player');","if (!player) return;","const state = runtimeScene.__sherenState || (runtimeScene.__sherenState = {vx:0,vy:0,score:0,got:[false,false,false],won:false,dead:false,grounded:false,prevJump:false});","const key = (name) => gdjs.evtTools.input.isKeyPressed(runtimeScene,name);","const delta = Math.min(runtimeScene.getElapsedTime()/1000,0.04);","const restart = () => gdjs.evtTools.runtimeScene.replaceScene(runtimeScene,'Game',false);","if ((state.dead && key('r')) || (state.won && key('Return')) || key('r')) { restart(); return; }","const message = get('InfoText');","get('VictoryText').hide(!state.won);","if (!state.won && !state.dead) {","  const horizontal = (key('Right')||key('d')?1:0)-(key('Left')||key('a')?1:0);","  state.vx=horizontal*245;","  player.setX(Math.max(0,Math.min(900-player.getWidth(),player.getX()+state.vx*delta)));","  const jumping=key('Space')||key('Up')||key('w');","  if (jumping && !state.prevJump && state.grounded) {state.vy=-565;state.grounded=false;}","  state.prevJump=jumping;","  state.vy+=1300*delta;","  const oldBottom=player.getY()+player.getHeight();","  player.setY(player.getY()+state.vy*delta);","  const floor=458;","  if(state.vy>=0 && player.getY()+player.getHeight()>=floor && oldBottom<=floor+24){player.setY(floor-player.getHeight());state.vy=0;state.grounded=true;}","  if (player.getY()>530) {state.dead=true;player.setAnimation(3);message.setString('Karakter jatuh! Tekan R untuk ulang.');}","  if(!state.dead){","    const anim= !state.grounded?2:horizontal!==0?1:0;","    if(player.getAnimation()!==anim)player.setAnimation(anim);","    if(horizontal<0)player.flipX(true);else if(horizontal>0)player.flipX(false);","    const labels=['PROGRAMMER','PIXEL ARTIST','PROJECT & LEVEL DESIGNER'];","    for(let i=0;i<3;i++){","      if(state.got[i])continue;","      const star=get('Star'+(i+1));","      if(star && Math.abs(player.getX()+player.getWidth()/2-(star.getX()+star.getWidth()/2))<55 && Math.abs(player.getY()+player.getHeight()/2-(star.getY()+star.getHeight()/2))<95){","        state.got[i]=true;state.score++;star.hide(true);","        message.setString(labels[i]+' - Sheren Agnesia Sukarno | 240533607010');","      }","    }","    get('ScoreText').setString('Bintang: '+state.score+'/3');","    if(state.score===3){get('Door').setAnimation(1);}","    const door=get('Door');","    if(state.score===3 && player.getX()+player.getWidth()>door.getX() && player.getX()<door.getX()+door.getWidth()){","      state.won=true;message.setString('Semua peran berhasil diperkenalkan!');get('VictoryText').hide(false);","    }","    const hazard=get('Hazard');","    if(hazard && player.getX()+player.getWidth()-25>hazard.getX() && player.getX()+25<hazard.getX()+hazard.getWidth() && player.getY()+player.getHeight()>hazard.getY() && player.getY()+player.getHeight()<hazard.getY()+hazard.getHeight()+25){","      state.dead=true;player.setAnimation(3);message.setString('Game over! Tekan R untuk ulang.');","    }","  }","}","","})();"],"parameterObjects":"","useStrict":true,"eventsSheetExpanded":true}],"layers":[{"ambientLightColorB":200,"ambientLightColorG":200,"ambientLightColorR":200,"camera2DPlaneMaxDrawingDistance":5000.0,"camera3DFarPlaneDistance":10000.0,"camera3DFieldOfView":45.0,"camera3DNearPlaneDistance":0.1,"cameraType":"perspective","followBaseLayerCamera":true,"isLightingLayer":false,"isLocked":false,"name":"","renderingType":"","visibility":true,"cameras":[],"effects":[]}],"behaviorsSharedData":[]}],"externalEvents":[],"eventsFunctionsExtensions":[],"externalLayouts":[]}